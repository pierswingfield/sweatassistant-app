# Copy to .env beside docker-compose.yml on the host (never commit a real .env).
NODE_ENV=production
PORT=3000

# REQUIRED in production: the server refuses to start without these two.
PUBLIC_HOST=app.example.com          # public domain: calendar feed URLs, UIDs, CORS allowlist
VAPID_EMAIL=mailto:ops@example.com   # Web Push contact (mailto: or https://)

# REQUIRED always: secrets (generate each, e.g. `openssl rand -hex 32`).
# ENCRYPTION_KEY must decode to exactly 32 bytes (64 hex chars from `openssl rand -hex 32`, or 32-byte base64);
# the server refuses to start otherwise. Do NOT change it on a live DB: stored gym credentials/sessions become unreadable.
ENCRYPTION_KEY=
# JWT_SECRET: set it in production. If absent a secret is generated into the SQLite file (and so into every
# backup). The admin-session secret is derived from it (HMAC, label 'dibs:admin-jwt:v1'); no extra variable.
# Changing it logs every user out once.
JWT_SECRET=
ADMIN_PASSWORD=

# Optional
APP_NAME=Dibs                         # brand text shown in the UI and notifications
# CORS_ORIGINS=https://app.example.com
# Reverse-proxy hops to trust for client IPs (default 1 in production = the Cloudflare Tunnel; 0 if exposed directly)
# TRUST_PROXY=1
# Per-gym rollout switches (see server/gyms.config.js)
# JAB_BOXING_ENABLED=true
# AARMY_ENABLED=true
