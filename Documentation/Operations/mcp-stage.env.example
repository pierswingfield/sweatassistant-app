# Copy privately to ~/services/sweatassistant-mcp-stage/.env.mcp-stage (0600).
# Never copy production/dev .env, keys, data, sessions or accounts.
MCP_STAGE_IMAGE=sweatassistant-mcp-stage:928d9cb
MCP_STAGE_ENABLED=true
APP_NAME=Sweat Assistant MCP Staging
VAPID_EMAIL=mailto:piers@piersj.com
# Operator generates independent high-entropy values directly into the private file.
ENCRYPTION_KEY=
JWT_SECRET=
ADMIN_PASSWORD=
METRICS_TOKEN=
MCP_STAGE_JAB_GATEWAY_KEY=
JAB_BOXING_ENABLED=true
AARMY_ENABLED=true
